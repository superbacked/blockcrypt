{
  "name": "blockcrypt",
  "version": "0.0.1-beta.24",
  "description": "Encrypt one or more secrets with plausible deniability.",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "package.json",
    "LICENCE",
    "README.md"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "25.9.1",
    "jest": "^30.4.2",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.9.4",
    "typescript": "5.9.3"
  },
  "scripts": {
    "code": "tsc -w",
    "typecheck": "tsc --noEmit",
    "format": "prettier '**/*.{json,md,ts}' --ignore-path .gitignore --write",
    "build": "rm -fr dist/*; tsc",
    "test": "jest dist/test.js",
    "prepublishOnly": "npm run build",
    "ncu": "ncu --target minor --upgrade"
  },
  "author": "Sun Knudsen <hello@sunknudsen.com>",
  "license": "MIT",
  "keywords": [
    "cryptography"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superbacked/blockcrypt.git"
  },
  "bugs": {
    "url": "https://github.com/superbacked/blockcrypt/issues"
  },
  "homepage": "https://github.com/superbacked/blockcrypt#readme",
  "prettier": {
    "endOfLine": "lf",
    "printWidth": 80,
    "semi": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
